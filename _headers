# Cloudflare Pages / Netlify 用のヘッダー設定
# HTML と Service Worker は毎回確認させ、中身のあるファイルだけキャッシュする。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# 単語データとコードは毎回サーバーに確認する（更新がすぐ出るように）。
# 中身が変わっていなければ 304 が返るだけなので転送量はほぼ増えない。
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/data/*
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=86400
